# fine-grained PAT — Contents: Read and write, Pull requests: Read and write,
# Metadata: Read-only. 블로그 저장소 하나만. 만료 90일.
# ★ 커밋되는 파일에 원문을 넣지 말 것 (docs/SECURITY.md §2)
GITHUB_TOKEN=github_pat_...

# 발행 대상 저장소
BLOG_REPO=owner/jiny-log

# 발행 URL 생성용 (끝에 슬래시 없이)
BLOG_SITE_URL=https://example.com

# 기본 브랜치 (선택, 기본값 main)
# BLOG_BASE_BRANCH=main

# true 면 모든 쓰기가 커밋 직전에 멈추고 diff 만 반환한다.
# 실제 토큰을 처음 연결할 때는 반드시 이 모드로 먼저 돌린다.
# MCP_DRY_RUN=true
